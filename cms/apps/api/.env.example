DATABASE_URL="postgresql://cms:cms@localhost:5433/cms"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
UPLOAD_DIR="./uploads"
PUBLIC_URL="http://localhost:4000"
ADMIN_ORIGIN="http://localhost:5173"

# Local development only. Skips sign-in; refused unless HOST is localhost.
# AUTH_DISABLED=true
HOST=localhost

# --- AI assistant (Live preview > AI). Add the keys you have; leave the rest empty. ---
# Keys stay on the server; they are never sent to the browser or written to the log.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: choose the model each provider uses
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4.1
# GEMINI_MODEL=gemini-3.1-pro-preview
# Optional: MCP servers the assistant may use (read-only tools only, unless "allowWrites": true)
# MCP_SERVERS=[{"name":"notes","url":"https://example.com/mcp","token":"..."}]
# Optional: REST APIs the assistant may read (GET only, only these hosts)
# API_SOURCES=[{"name":"products","baseUrl":"https://api.example.com/v1","token":"...","description":"Product catalogue"}]

# --- Change notification emails (optional) ---
# Members of a site get one email (a minute after the first change) when someone ELSE adds or changes something.
# Leave SMTP_HOST empty to keep email off; the bell inside the CMS works either way.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Synx Brain <brain@yourdomain.com>"
