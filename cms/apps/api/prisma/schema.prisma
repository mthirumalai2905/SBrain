generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum EntryStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean      @default(false)
  memberships  Membership[]
  createdAt    DateTime     @default(now())
}

model Site {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  domains      String[]
  previewUrl   String?
  apiKey       String        @unique
  memberships  Membership[]
  contentTypes ContentType[]
  entries      Entry[]
  media        Media[]
  connectors   Connector[]
  mcpKeys      McpKey[]
  createdAt    DateTime      @default(now())
}

model Membership {
  userId String
  siteId String
  role   Role   @default(EDITOR)
  /// Send this person an email when someone else adds or changes something on the site.
  notifyEmail Boolean @default(true)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
}

model ContentType {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  slug      String
  fields    Json     @default("[]")
  kind      String   @default("collection")
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  entries   Entry[]
  createdAt DateTime @default(now())

  @@unique([siteId, slug])
}

model Entry {
  id            String      @id @default(cuid())
  siteId        String
  contentTypeId String
  slug          String?
  data          Json        @default("{}")
  status        EntryStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  @@unique([contentTypeId, slug])
  @@index([siteId, status])
}

model Media {
  id           String   @id @default(cuid())
  siteId       String
  filename     String
  originalName String
  mimeType     String
  size         Int
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

/// A source the AI assistant may read from: an MCP server or a REST API. The token is stored encrypted.
model Connector {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  kind        String // "mcp" | "api"
  name        String
  url         String
  description String   @default("")
  /// header the token is sent in (APIs); empty = Authorization: Bearer
  tokenHeader String   @default("")
  tokenEnc    String?
  allowWrites Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([siteId, name])
}

/// A key that lets one AI tool (Claude, ChatGPT/Codex, Gemini, Cursor...) use the CMS through MCP. One key per tool, so one
/// can be removed without affecting the others. siteId empty = the key reaches every site.
model McpKey {
  id        String   @id @default(cuid())
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// which AI tool it is for: claude-code, claude-desktop, codex, gemini, cursor, vscode, windsurf, other
  tool      String   @default("other")
  label     String
  /// SHA-256 of the key, used to check requests
  hash      String   @unique
  /// the key itself, encrypted, so it can be shown again (empty for keys made before this existed)
  keyEnc    String?
  /// read | draft | publish
  perm      String   @default("draft")
  last4     String   @default("")
  createdAt DateTime @default(now())

  @@index([siteId])
}

/// One saved copy of a document, written every time it is created, changed, published or deleted. Kept after the document is deleted.
model EntryVersion {
  id        String   @id @default(cuid())
  entryId   String
  siteId    String
  typeName  String
  title     String
  slug      String?
  data      Json
  status    String
  /// created | edited | published | unpublished | deleted | restored
  action    String
  summary   String   @default("")
  actorId   String?
  actorName String
  /// cms | ai
  source    String   @default("cms")
  createdAt DateTime @default(now())

  @@index([entryId, createdAt])
  @@index([siteId, createdAt])
}

/// "Someone changed something": shown in the bell, and mailed to the site's members.
model Notification {
  id        String    @id @default(cuid())
  siteId    String
  entryId   String?
  action    String
  title     String
  summary   String    @default("")
  actorId   String?
  actorName String
  source    String    @default("cms")
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([siteId, createdAt])
  @@index([emailedAt])
}
