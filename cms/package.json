{
  "name": "synx-brain",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,admin,site -c blue,magenta,green \"npm:dev:api\" \"npm:dev:admin\" \"npm:dev:site\"",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run migrate -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build -w apps/api && npm run build -w apps/admin",
    "dev:site": "npm run dev -w apps/morph-space"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
